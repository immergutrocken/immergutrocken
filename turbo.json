{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "dev": {
      "outputs": ["dist/**", "build/**"]
    },
    "build": {
      "outputs": ["public/**", ".next/**"],
      "dependsOn": ["^build"],
      "env": ["MAILJET_*", "SANITY_STUDIO_*"]
    },
    "test": {
      "outputs": ["dist/**", "build/**"]
    },
    "test:ci": {
      "outputs": ["dist/**", "build/**"]
    },
    "test:e2e": {
      "cache": false,
      // ARGOS_*/GITHUB_* are what the Argos reporter authenticates with and reads the
      // CI context (repo, commit, branch, run id) from — turbo strips anything unlisted.
      "env": ["CI", "ARGOS_*", "GITHUB_*"]
    },
    "lint": {}
  }
}
